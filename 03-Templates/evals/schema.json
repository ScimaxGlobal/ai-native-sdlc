{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example-corp.com/schemas/agent-eval.json",
  "title": "Agent eval case",
  "description": "One regression case for the agent configuration (CLAUDE.md, skills, hooks, subagents, model). Run by evals/run-evals.sh; checked by evals/check.sh.",
  "type": "object",
  "required": ["id", "prompt", "checks"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Stable identifier; also the results file name."
    },
    "description": { "type": "string" },
    "owner": { "type": "string", "description": "Team that owns this case." },
    "origin": {
      "type": "string",
      "description": "Where the case came from: 'real-task', 'incident:PM-2026-007', 'scan:VULN-123', 'monitoring:INT-2026-031'."
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "prompt": { "type": "string", "minLength": 1, "description": "Exactly what is passed to claude -p." },
    "allowed_tools": {
      "type": "string",
      "default": "Read,Edit,Bash(make test)",
      "description": "Value for --allowedTools."
    },
    "max_turns": { "type": "integer", "minimum": 1, "default": 30 },
    "timeout_seconds": { "type": "integer", "minimum": 10, "default": 900 },
    "setup": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Shell commands run in the eval worktree before Claude starts (e.g. apply a patch that introduces the bug)."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["command", "file_contains", "file_not_contains", "file_unchanged", "output_contains", "output_not_contains", "no_error"]
          },
          "name": { "type": "string" },
          "run": { "type": "string", "description": "command: shell command to run." },
          "expect_exit": { "type": "integer", "default": 0, "description": "command: expected exit code." },
          "path": { "type": "string", "description": "file_*: path relative to the worktree root." },
          "pattern": { "type": "string", "description": "file_contains / output_contains: extended regex (grep -E)." }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "command" } } }, "then": { "required": ["run"] } },
          { "if": { "properties": { "type": { "enum": ["file_contains", "file_not_contains"] } } }, "then": { "required": ["path", "pattern"] } },
          { "if": { "properties": { "type": { "const": "file_unchanged" } } }, "then": { "required": ["path"] } },
          { "if": { "properties": { "type": { "enum": ["output_contains", "output_not_contains"] } } }, "then": { "required": ["pattern"] } }
        ]
      }
    }
  }
}
